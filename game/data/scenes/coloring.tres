[gd_resource type="Resource" script_class="SceneDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/scene_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/resources/step_def.gd" id="2_step"]

[sub_resource type="Resource" id="step_paint"]
script = ExtResource("2_step")
template_id = "t44_paint"
mode = "leave"
completion_threshold = 0.5
tool_id = "sponge"
item_ids = PackedStringArray("paint_red", "paint_blue")
slot_ids = PackedStringArray("color_canvas")

[sub_resource type="Resource" id="step_fill"]
script = ExtResource("2_step")
template_id = "t43_color_fill"
mode = "pick_one"
item_ids = PackedStringArray("paint_red", "paint_blue")
slot_ids = PackedStringArray("area_left", "area_right")
category_ids = PackedStringArray("paint_red", "paint_blue")

[resource]
script = ExtResource("1_def")
id = "coloring"
background_id = "bg_playroom"
music_id = "music_playroom"
steps = Array[Resource]([SubResource("step_paint"), SubResource("step_fill")])
next_scene_id = "home"
