[gd_resource type="Resource" script_class="SceneDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/scene_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/resources/step_def.gd" id="2_step"]

[sub_resource type="Resource" id="step_play"]
script = ExtResource("2_step")
template_id = "t21_touch_each"
mode = "count_n"
repeat_count = 3
item_ids = PackedStringArray("ball", "pinwheel", "plush")
on_hit_pose = "laughing"
hit_poses = PackedStringArray("laughing", "laughing", "laughing")
on_hit_sfx_id = "sfx_heart"
care_step_id = "PLAY"

[resource]
script = ExtResource("1_def")
id = "playroom"
background_id = "bg_playroom"
music_id = "music_playroom"
intro_voice_key = "vo.playroom.intro"
steps = Array[Resource]([SubResource("step_play")])
next_scene_id = "home"
