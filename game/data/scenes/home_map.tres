on_miss_sfx_id = "sfx_soft_error"

[resource]
script = ExtResource("1_def")
id = "home_map"
background_id = "bg_home"
music_id = "music_main_theme"
steps = Array[Resource]([SubResource("step_map")])
next_scene_id = "home"
